# .env.example: variable NAMES only (C10, OPS-03, SEC-08). Never put a value that is a secret here,
# and never commit a filled-in copy: .env is gitignored.
#
# The examiner bring-up needs NO .env at all:
#   git clone <repo>; cd plotinium; docker compose up -d --wait; open http://localhost:4717
# Database passwords are generated at first start into the dbsecrets volume; user passwords are
# generated by the seed and printed once in `docker compose logs app`.
#
# Local overrides (all optional; compose.yaml has the defaults):
PLOTINIUM_PORT=
PLOTINIUM_ENV=
PLOTINIUM_SEED_PROFILE=
LEASE_TTL_MS=
LLM_MODE=
AI=
#
# Production (/srv/plotinium/.env on the VPS, mode 0600; non-secret settings only):
PLOTINIUM_DOMAIN=
LLM_BUDGET_USD_MONTH=
LLM_BUDGET_USD_TOTAL=
#
# Written by ops/deploy.sh into /srv/plotinium/.env.images (image references by digest):
PLOTINIUM_DB_IMAGE=
PLOTINIUM_APP_IMAGE=
PLOTINIUM_WEB_IMAGE=
#
# Secrets are FILES, never variables in this file (backend-api.md §3.4):
#   /srv/plotinium/secrets/anthropic_api_key     -> ANTHROPIC_API_KEY_FILE (compose.prod.yaml)
#   /srv/plotinium/secrets/llm_upstream_accept   -> LLM_UPSTREAM_ACCEPT_FILE
#   /srv/plotinium/secrets/rclone.conf           -> ops/backup.sh (host only, never in a container)
