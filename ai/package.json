{
  "name": "@plotinium/ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI subsystems as OS processes: embedding worker, indexer, semantic search, agentic shell, predictor, evaluation harnesses.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./kernel": "./src/kernel/index.ts",
    "./programs": "./src/programs/index.ts",
    "./embed-worker": "./src/embed/embed.worker.ts",
    "./hooks": "./src/hooks.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --root .. --project ai",
    "fetch-models": "node scripts/fetch-models.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "catalog:",
    "@plotinium/dsa": "workspace:*",
    "@plotinium/kernel": "workspace:*",
    "@plotinium/protocol": "workspace:*"
  },
  "sideEffects": [
    "./src/embed/embed.worker.ts"
  ]
}
