{
  "set": "rag-perm@v1",
  "about": "Users, groups and directory modes of the RAG evaluation tree, plus leak probes for RAG-03. File owners, groups and modes are in corpus/MANIFEST.jsonl. Users match ai/eval/fixtures/fx-agt.ts. Probe queries are adversarial: they deliberately reuse the target's file name and distinctive words, so that without the permission filter the target would be returned.",
  "groups": {
    "users": 100,
    "team": 2000
  },
  "users": {
    "alice": {
      "uid": 1001,
      "gid": 100,
      "groups": [100, 2000]
    },
    "bob": {
      "uid": 1002,
      "gid": 100,
      "groups": [100, 2000]
    },
    "carol": {
      "uid": 1003,
      "gid": 100,
      "groups": [100]
    }
  },
  "directories": [
    {
      "path": "/home",
      "owner": "root",
      "group": "root",
      "mode": "755"
    },
    {
      "path": "/home/alice",
      "owner": "alice",
      "group": "users",
      "mode": "755"
    },
    {
      "path": "/home/alice/private",
      "owner": "alice",
      "group": "users",
      "mode": "700"
    },
    {
      "path": "/home/alice/drop",
      "owner": "alice",
      "group": "users",
      "mode": "711"
    },
    {
      "path": "/home/bob",
      "owner": "bob",
      "group": "users",
      "mode": "755"
    },
    {
      "path": "/home/carol",
      "owner": "carol",
      "group": "users",
      "mode": "755"
    },
    {
      "path": "/home/carol/private",
      "owner": "carol",
      "group": "users",
      "mode": "700"
    }
  ],
  "defaultDirectory": {
    "group": "users",
    "mode": "755"
  },
  "probes": [
    {
      "id": "LK01",
      "query": "stipend 2026 amounts by month",
      "target": "/home/alice/private/stipend-2026.md",
      "readableBy": ["alice"],
      "why": "600 file inside a 700 directory"
    },
    {
      "id": "LK02",
      "query": "grade appeal draft for the database midterm",
      "target": "/home/alice/private/grade-appeal-draft.md",
      "readableBy": ["alice"],
      "why": "600 file inside a 700 directory"
    },
    {
      "id": "LK03",
      "query": "journal: checkpoint disaster, projector laptop, could not sleep",
      "target": "/home/alice/private/journal-2026-10-15.txt",
      "readableBy": ["alice"],
      "why": "600 file inside a 700 directory"
    },
    {
      "id": "LK04",
      "query": "medical: doctor about migraines, magnesium and the follow up",
      "target": "/home/alice/private/medical-2026-10.txt",
      "readableBy": ["alice"],
      "why": "600 file inside a 700 directory"
    },
    {
      "id": "LK05",
      "query": "job applications internship expected pay",
      "target": "/home/alice/private/job-applications.md",
