"""Toy keyword ranker I wrote to understand BM25 before R3 built the real one."""
import math
import re
from collections import Counter

K1, B = 1.2, 0.75


def tokens(text):
    return re.findall(r"[a-z0-9_]+", text.lower())


class Index:
    def __init__(self, docs):
        self.docs = {name: Counter(tokens(body)) for name, body in docs.items()}
        self.lengths = {n: sum(c.values()) for n, c in self.docs.items()}
        self.avg = sum(self.lengths.values()) / max(1, len(self.docs))
        self.df = Counter(t for c in self.docs.values() for t in c)

    def idf(self, term):
        n, nt = len(self.docs), self.df.get(term, 0)
        return math.log(1 + (n - nt + 0.5) / (nt + 0.5))

    def score(self, query, name):
        tf, length = self.docs[name], self.lengths[name]
        s = 0.0
        for t in set(tokens(query)):
            f = tf.get(t, 0)
            if f:
                s += self.idf(t) * f * (K1 + 1) / (f + K1 * (1 - B + B * length / self.avg))
        return s

    def search(self, query, k=5):
        ranked = sorted(self.docs, key=lambda n: -self.score(query, n))
        return [(n, round(self.score(query, n), 3)) for n in ranked[:k] if self.score(query, n) > 0]


if __name__ == "__main__":
    idx = Index({"a": "the cat sat on the mat", "b": "dogs and cats", "c": "a mat for yoga"})
    print(idx.search("cat mat"))
