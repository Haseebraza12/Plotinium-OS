/**
 * Minimal typed publish/subscribe used inside the window manager (not the kernel bus).
 * `on` returns an unsubscribe function; always call it in the component's cleanup.
 */
type Handler<T> = (payload: T) => void;

export class EventBus<Events extends Record<string, unknown>> {
  private readonly handlers = new Map<keyof Events, Set<Handler<never>>>();

  on<K extends keyof Events>(topic: K, handler: Handler<Events[K]>): () => void {
    let set = this.handlers.get(topic);
    if (set === undefined) {
      set = new Set();
      this.handlers.set(topic, set);
    }
    set.add(handler as Handler<never>);
    return () => {
      set.delete(handler as Handler<never>);
      if (set.size === 0) this.handlers.delete(topic);
    };
  }

  emit<K extends keyof Events>(topic: K, payload: Events[K]): void {
    for (const h of [...(this.handlers.get(topic) ?? [])]) (h as Handler<Events[K]>)(payload);
  }

  listenerCount(topic: keyof Events): number {
    return this.handlers.get(topic)?.size ?? 0;
  }
}

