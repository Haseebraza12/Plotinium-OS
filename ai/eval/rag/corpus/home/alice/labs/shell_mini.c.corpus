/* Assignment 2: a tiny shell. Reads a line, splits on spaces, runs the command in a child.
 * Supports `cd`, `exit` and a trailing & for background jobs. No pipes yet. */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/wait.h>
#include <unistd.h>

#define MAX_ARGS 32

int main(void) {
    char line[1024];
    for (;;) {
        while (waitpid(-1, NULL, WNOHANG) > 0) ; /* reap finished background jobs */
        printf("msh$ ");
        fflush(stdout);
        if (!fgets(line, sizeof line, stdin)) break;
        char *argv[MAX_ARGS];
        int argc = 0;
        for (char *tok = strtok(line, " \t\n"); tok && argc < MAX_ARGS - 1; tok = strtok(NULL, " \t\n"))
            argv[argc++] = tok;
        argv[argc] = NULL;
        if (argc == 0) continue;
        int background = strcmp(argv[argc - 1], "&") == 0;
        if (background) argv[--argc] = NULL;
        if (strcmp(argv[0], "exit") == 0) break;
        if (strcmp(argv[0], "cd") == 0) {
            if (chdir(argc > 1 ? argv[1] : getenv("HOME")) < 0) perror("cd");
            continue;
        }
        pid_t pid = fork();
        if (pid == 0) {
            execvp(argv[0], argv);
            perror(argv[0]);
            _exit(127);
        }
        if (!background) waitpid(pid, NULL, 0);
        else printf("[bg] %d\n", pid);
    }
    return 0;
}
