.env
.env.*
!.env.example

# Logs and OS or editor files
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# The pilot evidence is committed verbatim, including its coverage report (C16).
!/docs/evidence/pilot/**/coverage/
