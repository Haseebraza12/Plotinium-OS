// Runs in the kernel worker (IndexedDB). src/path.ts and src/perm.ts are isomorphic: the server type-checks them without DOM.
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable", "WebWorker"],
    "types": []
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", "coverage"]
}
